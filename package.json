{
  "name": "dsh-delegation",
  "version": "1.0.0",
  "description": "Delegate work to a local DeepSeek Harness (DSH) instance from any coding agent: persistent conversations, push-based replies, native image input. Zero dependencies.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "agent",
    "delegation",
    "subagent",
    "rpc",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "dsh-delegation": "./dsh_cli.mjs"
  },
  "files": [
    "dsh_bridge.mjs",
    "dsh_cli.mjs",
    "dsh_ws.mjs",
    "SKILL.md",
    "docs/",
    "tests/"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "doctor": "node dsh_cli.mjs doctor"
  }
}
